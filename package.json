{
  "name": "cutable",
  "private": true,
  "scripts": {
    "build": "npm --prefix apps/frontend run build && cd apps/backend && go build ./cmd/server",
    "dev:frontend": "npm --prefix apps/frontend run dev",
    "dev:backend": "cd apps/backend && go run ./cmd/server",
    "lint": "npm --prefix apps/frontend run lint",
    "test": "cd apps/backend && go test ./..."
