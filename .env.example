# Backend
PORT=3010
DATABASE_URL=postgresql://cutable:cutable_local_dev@localhost:5432/cutable?sslmode=disable
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# AI model (required; Cutable intentionally has no hard-coded model)
OPENROUTER_API_KEY=sk-or-v1-replace-me
OPENROUTER_MODEL=openai/gpt-5-mini

# E2B sandbox
E2B_API_KEY=e2b_replace_me
E2B_TEMPLATE_ALIAS=cutable-react-base
SANDBOX_TIMEOUT=15m

# Agent limits
AGENT_TIMEOUT=12m
AGENT_MAX_STEPS=40

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3010
NEXT_PUBLIC_WS_URL=ws://localhost:3010
